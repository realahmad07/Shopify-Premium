<section class="featured container">
  <div class="section-head">
    <div>
      <p class="eyebrow">Best sellers</p>
      <h2 class="section-title">Signature pieces</h2>
    </div>
  </div>

  <div class="slider-arrows" aria-label="Featured product navigation">
    <button aria-label="Previous">‹</button>
    <button aria-label="Next">›</button>
  </div>

  <div class="product-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <article class="product-card">
          <div class="product-media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: alt: block.settings.title }}
            {% endif %}
          </div>
          <div class="product-info">
            <span class="product-tag">Heritage</span>
            <h4>{{ block.settings.title }}</h4>
            <p class="product-price">{{ block.settings.price }}</p>
            <div class="product-actions">
              <a href="/collections/all" class="outline-btn">Quick view</a>
              <a href="/collections/all" class="primary-btn">Add to cart</a>
            </div>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <article class="product-card">
        <div class="product-media"><img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80" alt="Classic menswear" /></div>
        <div class="product-info">
          <span class="product-tag">Bestseller</span>
          <h4>Classic Silk Kurta</h4>
          <p class="product-price">PKR 7,499</p>
          <div class="product-actions">
            <a href="/collections/all" class="outline-btn">Quick view</a>
            <a href="/collections/all" class="primary-btn">Add to cart</a>
          </div>
        </div>
      </article>
      <article class="product-card">
        <div class="product-media"><img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=900&q=80" alt="Festive suit" /></div>
        <div class="product-info">
          <span class="product-tag">Festive</span>
          <h4>Royal Lawn Suit</h4>
          <p class="product-price">PKR 9,999</p>
          <div class="product-actions">
            <a href="/collections/all" class="outline-btn">Quick view</a>
            <a href="/collections/all" class="primary-btn">Add to cart</a>
          </div>
        </div>
      </article>
      <article class="product-card">
        <div class="product-media"><img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=80" alt="Ladies boutique outfit" /></div>
        <div class="product-info">
          <span class="product-tag">Signature</span>
          <h4>Designer Women Set</h4>
          <p class="product-price">PKR 11,499</p>
          <div class="product-actions">
            <a href="/collections/all" class="outline-btn">Quick view</a>
            <a href="/collections/all" class="primary-btn">Add to cart</a>
          </div>
        </div>
      </article>
      <article class="product-card">
        <div class="product-media"><img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=80" alt="Shawl collection" /></div>
        <div class="product-info">
          <span class="product-tag">Featured</span>
          <h4>Premium Shawl</h4>
          <p class="product-price">PKR 6,499</p>
          <div class="product-actions">
            <a href="/collections/all" class="outline-btn">Quick view</a>
            <a href="/collections/all" class="primary-btn">Add to cart</a>
          </div>
        </div>
      </article>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "text", "id": "title", "label": "Product name", "default": "Classic Silk Kurta" },
        { "type": "text", "id": "price", "label": "Price", "default": "PKR 7,499" }
      ]
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
